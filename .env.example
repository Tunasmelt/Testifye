# Supabase — get from supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose client-side

# AI Providers
GROQ_API_KEY=           # Required — get free key at console.groq.com
GOOGLE_AI_API_KEY=      # Fallback — free at ai.google.dev

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
