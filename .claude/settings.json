{
  "permissions": {
    "allow": [
      "Bash(bash .agent/scripts/*)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add .agent/ HANDOFF.md)",
      "Bash(git commit -m 'ctx:*')"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "bash -c 'BRANCH=$(git branch --show-current 2>/dev/null); if [[ \"$BRANCH\" == \"main\" || \"$BRANCH\" == \"master\" ]]; then echo \"BLOCKED: on $BRANCH — create a feature branch first\"; exit 1; fi'"
        }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "bash -c 'echo \"[session end] Run /ctx-dump before closing.\"'"
        }]
      }
    ]
  }
}
